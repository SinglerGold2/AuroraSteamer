# Copy this file to ~/.config/aurorasteamer.conf and adjust the values.
# Every setting is optional; the defaults are shown here.

# Language of the configuration window, e.g. "de", "en" or "tlh".
# Empty means: follow the system locale.
LANGUAGE=

# Path to Aurora.exe
AURORA_EXE="$HOME/Aurora/Aurora.exe"

# File with one Steam AppID per line. Listed games do not start Aurora.
IGNORE_FILE="$HOME/.config/aurora-ignore.txt"

# How often to look for a running game, in seconds.
POLL_INTERVAL=10

# Slower interval while no game is running, in seconds.
POLL_IDLE_INTERVAL=30

# Seconds to wait after the game was detected before Aurora starts.
START_DELAY=5

# Where the watcher remembers the game it started Aurora for. Optional.
# The default is a file in the runtime directory, cleared at logout.
# STATE_FILE="$XDG_RUNTIME_DIR/aurorasteamer.state"
